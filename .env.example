# Copia este archivo como ".env" y cambia las contraseñas.
# Estos valores solo son para desarrollo local; nunca subas tu .env a GitHub.

# --- MySQL (contenedor Docker) ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=his_citas
MYSQL_USER=citas_user
MYSQL_PASSWORD=cambia_esta_clave_app

# Puerto en tu PC para conectarte a MySQL (Workbench, DBeaver, etc.)
DB_PORT=3307

# --- API REST + frontend ---
API_PORT=3000
CLINIC_TIMEZONE=America/Guatemala
SLOT_MINUTES=30
